{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oulipoly.dev/opencode/native-identity-rebind/v1",
  "x-protocol": "opencode.native-identity-rebind/v1",
  "title": "OpenCode Native Identity Rebind Maintenance Protocol",
  "type": "object",
  "$defs": {
    "Profile": {
      "enum": ["opencode1", "opencode2", "opencode3", "opencode4", "opencode5"]
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "OptionalDigest": {
      "oneOf": [
        { "$ref": "#/$defs/Digest" },
        { "type": "null" }
      ]
    },
    "BindingEvidence": {
      "type": "object",
      "properties": {
        "native_runtime_state_sha256": { "$ref": "#/$defs/OptionalDigest" },
        "quota_observer_state_sha256": { "$ref": "#/$defs/OptionalDigest" }
      },
      "required": ["native_runtime_state_sha256", "quota_observer_state_sha256"],
      "additionalProperties": false
    },
    "PlanRequest": {
      "type": "object",
      "properties": {
        "protocol": { "const": "opencode.native-identity-rebind/v1" },
        "action": { "const": "plan" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Profile" }
        }
      },
      "required": ["protocol", "action", "profiles"],
      "additionalProperties": false
    },
    "SealHandoff": {
      "type": "object",
      "properties": {
        "ordinary_admission_blocked": { "type": "boolean" },
        "obligations_reconciled": { "type": "boolean" }
      },
      "required": ["ordinary_admission_blocked", "obligations_reconciled"],
      "additionalProperties": false
    },
    "ObservationHandoff": {
      "type": "object",
      "properties": {
        "ordinary_admission_blocked": { "type": "boolean" },
        "validation_launch_completed": { "type": "boolean" },
        "validation_quota_probe_completed": { "type": "boolean" }
      },
      "required": [
        "ordinary_admission_blocked",
        "validation_launch_completed",
        "validation_quota_probe_completed"
      ],
      "additionalProperties": false
    },
    "ReleaseHandoff": {
      "type": "object",
      "properties": {
        "ordinary_admission_reopened": { "type": "boolean" }
      },
      "required": ["ordinary_admission_reopened"],
      "additionalProperties": false
    },
    "SealRequest": {
      "type": "object",
      "properties": {
        "protocol": { "const": "opencode.native-identity-rebind/v1" },
        "action": { "const": "seal" },
        "operation_id": { "$ref": "#/$defs/Digest" },
        "profile": { "$ref": "#/$defs/Profile" },
        "prior_binding": { "$ref": "#/$defs/BindingEvidence" },
        "host_handoff": { "$ref": "#/$defs/SealHandoff" }
      },
      "required": ["protocol", "action", "operation_id", "profile", "prior_binding", "host_handoff"],
      "additionalProperties": false
    },
    "ObservationRequest": {
      "type": "object",
      "properties": {
        "protocol": { "const": "opencode.native-identity-rebind/v1" },
        "action": { "const": "observe" },
        "operation_id": { "$ref": "#/$defs/Digest" },
        "profile": { "$ref": "#/$defs/Profile" },
        "prior_binding": { "$ref": "#/$defs/BindingEvidence" },
        "disposition": { "enum": ["committed", "rolled_back"] },
        "host_handoff": { "$ref": "#/$defs/ObservationHandoff" }
      },
      "required": ["protocol", "action", "operation_id", "profile", "prior_binding", "disposition", "host_handoff"],
      "additionalProperties": false
    },
    "ReleaseRequest": {
      "type": "object",
      "properties": {
        "protocol": { "const": "opencode.native-identity-rebind/v1" },
        "action": { "const": "release" },
        "operation_id": { "$ref": "#/$defs/Digest" },
        "observation_id": { "$ref": "#/$defs/Digest" },
        "profile": { "$ref": "#/$defs/Profile" },
        "prior_binding": { "$ref": "#/$defs/BindingEvidence" },
        "observed_binding": { "$ref": "#/$defs/BindingEvidence" },
        "disposition": { "enum": ["committed", "rolled_back"] },
        "host_handoff": { "$ref": "#/$defs/ReleaseHandoff" }
      },
      "required": ["protocol", "action", "operation_id", "observation_id", "profile", "prior_binding", "observed_binding", "disposition", "host_handoff"],
      "additionalProperties": false
    },
    "Request": {
      "oneOf": [
        { "$ref": "#/$defs/PlanRequest" },
        { "$ref": "#/$defs/SealRequest" },
        { "$ref": "#/$defs/ObservationRequest" },
        { "$ref": "#/$defs/ReleaseRequest" }
      ]
    },
    "Responsibility": {
      "type": "object",
      "properties": {
        "actor": { "enum": ["host", "operator", "provider"] },
        "action": { "type": "string", "minLength": 1 },
        "completion": { "type": "string", "minLength": 1 }
      },
      "required": ["actor", "action", "completion"],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "kind": { "const": "native_identity_rebind" },
        "protocol": { "const": "opencode.native-identity-rebind/v1" },
        "schema_id": { "const": "opencode.native-identity-rebind/v1" },
        "operation_id": { "$ref": "#/$defs/Digest" },
        "profile": { "$ref": "#/$defs/Profile" },
        "phase": { "enum": ["awaiting_host_drain", "awaiting_cutover", "awaiting_host_release", "completed", "rolled_back", "rejected"] },
        "maximum_drain_ms": { "const": 20000 },
        "prior_binding": { "$ref": "#/$defs/BindingEvidence" },
        "observed_binding": { "$ref": "#/$defs/BindingEvidence" },
        "observation_id": { "$ref": "#/$defs/Digest" },
        "disposition": { "enum": ["committed", "rolled_back"] },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Responsibility" }
        },
        "next_request": { "$ref": "#/$defs/Request" },
        "diagnostic": { "type": "string", "minLength": 1 },
        "implementation_evidence": {
          "type": "object",
          "properties": {
            "provider_state_records": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["provider_state_records"],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "protocol",
        "schema_id",
        "operation_id",
        "profile",
        "phase",
        "maximum_drain_ms",
        "prior_binding",
        "observed_binding",
        "responsibilities",
        "implementation_evidence"
      ],
      "allOf": [
        {
          "if": { "properties": { "phase": { "const": "awaiting_host_drain" } } },
          "then": {
            "required": ["next_request"],
            "properties": { "next_request": { "$ref": "#/$defs/SealRequest" } }
          }
        },
        {
          "if": { "properties": { "phase": { "const": "awaiting_cutover" } } },
          "then": {
            "required": ["next_request"],
            "properties": { "next_request": { "$ref": "#/$defs/ObservationRequest" } }
          }
        },
        {
          "if": { "properties": { "phase": { "const": "awaiting_host_release" } } },
          "then": {
            "required": ["observation_id", "disposition", "next_request"],
            "properties": { "next_request": { "$ref": "#/$defs/ReleaseRequest" } }
          }
        },
        {
          "if": { "properties": { "phase": { "enum": ["completed", "rolled_back", "rejected"] } } },
          "then": {
            "required": ["observation_id", "disposition"],
            "not": { "required": ["next_request"] }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
